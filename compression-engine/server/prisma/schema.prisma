// ═════════════════════════════════════════════════════════════════════════
// CompressionAI — Production PostgreSQL Schema (Supabase Pooler)
// ═════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  password           String
  name               String
  avatar             String?
  role               String   @default("developer")
  theme              String   @default("dark")
  language           String   @default("en")
  preferredLlm       String   @default("openai")
  defaultCompression String   @default("medium")
  isActive           Boolean  @default(true)
  emailVerified      Boolean  @default(false)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions      Session[]
  apiKeys       ApiKey[]
  documents     Document[]
  compressions  Compression[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  refreshHash String   @unique
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  usedAt     DateTime?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

model ApiKey {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  label          String?
  encryptedKey   String
  keyPrefix      String
  keyFingerprint String
  isActive       Boolean  @default(true)
  lastUsedAt     DateTime?
  usageCount     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, keyFingerprint])
  @@index([userId, provider])
  @@map("api_keys")
}

model Document {
  id           String   @id @default(uuid())
  userId       String
  filename     String
  originalName String
  mimeType     String
  size         Int
  documentType String
  language     String?
  content      String?
  pages        Int?
  words        Int?
  characters   Int?
  tokens       Int?
  storagePath  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  compressions Compression[]

  @@index([userId])
  @@map("documents")
}

model Compression {
  id                  String   @id @default(uuid())
  userId              String
  documentId          String?
  originalText        String
  compressedText      String
  originalTokens      Int
  compressedTokens    Int
  compressionRatio    Float
  semanticScore       Float
  compressionLevel    String
  requestedLevel      String?
  llmProvider         String?
  llmModel            String?
  documentType        String
  language            String?
  originalCost        Float
  compressedCost      Float
  costSavings         Float
  latencyOriginalMs   Float?
  latencyCompressedMs Float?
  latencyImprovement  Float?
  processingTimeMs    Float?
  accuracyTarget      Float    @default(0.95)
  metTarget           Boolean  @default(true)
  adaptiveFallback    Boolean  @default(false)
  status              String   @default("completed")
  errorMessage        String?
  createdAt           DateTime @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  metrics  CompressionMetric?

  @@index([userId])
  @@map("compressions")
}

model CompressionMetric {
  id                 String   @id @default(uuid())
  compressionId      String   @unique
  tokensSaved        Int
  wordsSaved         Int
  charactersSaved    Int
  moneySaved         Float
  latencyReduced     Float
  semanticSimilarity Float
  reasoningRetention Float
  estimatedAccuracy  Float
  approved           Boolean  @default(true)
  agentCount         Int      @default(0)
  agentTimings       String?
  createdAt          DateTime @default(now())

  compression Compression @relation(fields: [compressionId], references: [id], onDelete: Cascade)

  @@map("compression_metrics")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String?
  resourceId String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@map("activity_logs")
}
