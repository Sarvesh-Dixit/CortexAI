{
  "framework": null,
  "installCommand": "npm install --include=dev && npx prisma generate",
  "buildCommand": "npm run build",
  "outputDirectory": ".vercel/output",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{eng.traineddata,node_modules/tesseract.js-core/*.wasm,node_modules/tesseract.js-core/*.wasm.js,node_modules/.prisma/**,node_modules/@prisma/client/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
