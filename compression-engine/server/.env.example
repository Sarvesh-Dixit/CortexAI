# ═════════════════════════════════════════════════════════════════════════
# CompressionAI — Server Environment
# Copy to .env and fill in real values. NEVER commit the real .env.
# ═════════════════════════════════════════════════════════════════════════

# ─── DATABASE (Supabase Postgres) ────────────────────────────────────────
# Get both from Supabase → Project Settings → Database → Connection string
#   • DATABASE_URL uses the TRANSACTION pooler (port 6543) — for runtime
#   • DIRECT_URL   uses the DIRECT connection (port 5432) — for migrations
# Add `?pgbouncer=true&connection_limit=1` to DATABASE_URL for serverless.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── LOCAL DEV WITHOUT SUPABASE (uncomment to use SQLite instead) ────────
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"

# ─── AUTH SECRETS ────────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotate these to invalidate all sessions.
JWT_SECRET="__GENERATE_A_64_BYTE_RANDOM_HEX_STRING_HERE__"
JWT_REFRESH_SECRET="__GENERATE_A_DIFFERENT_64_BYTE_RANDOM_HEX_STRING_HERE__"

# ─── ENCRYPTION KEY for stored API keys (AES-256-GCM) ────────────────────
# MUST be exactly 32 bytes = 64 hex chars. Rotating this key requires
# re-encrypting every row in api_keys — plan carefully.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="__GENERATE_A_32_BYTE_RANDOM_HEX_STRING_HERE__"

# ─── SERVER ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
CORS_ORIGIN="https://your-frontend.example.com"

# ─── LLM PROVIDER FALLBACK KEYS ──────────────────────────────────────────
# Used only when a user has NOT added their own key in Settings.
# Leave blank to require users to bring their own keys (recommended for prod).
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
LLAMA_API_KEY=

# ─── OLLAMA (local, no key needed) ───────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
