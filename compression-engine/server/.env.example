# ─────────────────────────────────────────────────────────
# CompressionAI Server Environment
# Copy this file to .env and fill in real values.
# NEVER commit the real .env — it's git-ignored.
# ─────────────────────────────────────────────────────────

DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────
# LLM Provider API keys (SYSTEM-LEVEL FALLBACKS)
# Used only when a user has NOT added their own key in Settings.
# Leave blank to require users to bring their own keys.
# ─────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
LLAMA_API_KEY=

# Ollama runs locally, no key needed
OLLAMA_HOST=http://localhost:11434
