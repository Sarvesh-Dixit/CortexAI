{
  "name": "compression-engine-server",
  "version": "1.0.0",
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && npx tsc --skipLibCheck",
