{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs18.x",
      "maxDuration": 300,
      "includeFiles": "compression-engine/server/eng.traineddata"
    }
  },
  "installCommand": "cd compression-engine/server && npm install --include=dev",
  "buildCommand": "cd compression-engine/server && npm run build"
}
